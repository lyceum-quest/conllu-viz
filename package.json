{
  "name": "conllu-viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beautiful, interactive CoNLL-U dependency tree visualizer",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "bash ./scripts/deploy.sh",
    "import": "tsx scripts/import-conllu.ts",
    "lint": "tsx scripts/lint.ts",
    "lint:all": "tsx scripts/lint.ts",
    "lint:test": "tsx scripts/lint-test.ts",
    "test": "tsx scripts/srs-test.ts",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "prebuild": "npm run fetch-data",
    "predev": "test -f public/preload/conllu-files.json || npm run fetch-data"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
